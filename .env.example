# Port for Node-backenden
PORT=3001
# Mill API (fra OpenAPI-spesifikasjonen)
MILL_API_BASE=https://api.millnorwaycloud.com
# Tibber personlig token: https://developer.tibber.com/settings/access-token
TIBBER_TOKEN=
# Easee-lader: samme innlogging som i Easee-appen
EASEE_USERNAME=
EASEE_PASSWORD=
# Philips Hue Remote API: app fra https://developers.meethue.com (Remote Hue API appids)
# Callback-URL i Hue-appen må være lik HUE_CALLBACK_URL
HUE_CLIENT_ID=
HUE_CLIENT_SECRET=
HUE_CALLBACK_URL=http://localhost:5173/api/hue/callback
# TP-Link Deco (lokalt): IP til hoved-Deco og admin-passordet (samme som i Deco-appen)
# Tips: lag en egen «manager»-konto i Deco-appen, ellers kan appen din bli logget ut
DECO_HOST=192.168.68.1
DECO_USERNAME=admin
DECO_PASSWORD=
# Sonos Control API: integration fra https://developer.sonos.com
# Redirect-URL må være HTTPS og offentlig (Sonos krav) – samme verdi som registrert hos Sonos
SONOS_CLIENT_ID=
SONOS_CLIENT_SECRET=
SONOS_REDIRECT_URI=
# Sett til true bak HTTPS i produksjon (secure-cookie)
COOKIE_SECURE=false
